    },
    "positive": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "checkpoint",
          1
        ],
        "text": "photorealistic interior photograph, professional architectural photography, 8k uhd, natural lighting, \u0422\u0417: \u0412\u0430\u043d\u043d\u0430\u044f \u043a\u043e\u043c\u043d\u0430\u0442\u0430 \u0434\u043b\u044f \u041c\u0430\u0448\u0438\n\nWALLS: white glossy wavy subway tiles, Equipe Costa Nova White style, 3D ribbed texture, vertical orientation, 50x200mm\nFLOOR: blue ceramic floor tiles with white geometric pattern, Equipe Rivoli Bergen Azul style, intersecting circles/petals, mediterranean, 200x200mm\nBATHTUB: white cast iron bathtub Jacob Delafon Soissons 160x70cm, front panel covered with white Costa Nova tiles\nVANITY: wall-mounted dark charcoal gray vanity cabinet IDDIS Edifice 100cm, two soft-close drawers, white ceramic sink on top, chrome faucet IDDIS Aiger\nSHOWER_SCREEN: glass shower screen panel, minimalist frameless design, transparent\nRAINSHOWER: chrome shower system IDDIS Aiger with large 228mm rain shower head and handheld shower\nTOWEL_WARMER: WHITE vertical electric heated towel rail Ewrika Penelopa X5 270x1200mm, NOT black NOT chrome, white color only\nWINDOW: small window with white PVC frame, frosted glass, warm natural daylight source\nBASKET: round woven natural rattan laundry basket La Redoute bohemian style with lid, beige color\nMIRROR: rectangular mirror IDDIS Uniq with rounded corners and integrated warm LED backlight 3000K around perimeter"
      }
    },
    "negative": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "clip": [
          "checkpoint",
          1
        ],
        "text": "cartoon, anime, drawing, sketch, low quality, blurry, distorted, watermark, text, objects not in reference, extra fixtures, additional decorations, modified wall structure, added ledges, steps, shelves, extra towels, human figure, person"
      }
    },
    "controlnet_canny": {
      "class_type": "ControlNetLoader",
