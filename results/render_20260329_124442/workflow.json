    "controlnet_depth": {
      "class_type": "ControlNetLoader",
      "inputs": {
        "control_net_name": "controlnet-depth-sdxl.safetensors"
      }
    },
    "canny_preprocess": {
      "class_type": "Canny",
      "inputs": {
        "image": [
          "load_beauty",
          0
        ],
        "low_threshold": 0.1,
        "high_threshold": 0.4
      }
    },
    "apply_controlnet_canny": {
      "class_type": "ControlNetApplyAdvanced",
      "inputs": {
        "positive": [
          "positive",
          0
        ],
        "negative": [
          "negative",
          0
        ],
        "control_net": [
          "controlnet_canny",
          0
        ],
        "image": [
          "canny_preprocess",
          0
        ],
        "strength": 0.8,
        "start_percent": 0.0,
        "end_percent": 0.9
      }
    },
    "apply_controlnet_depth": {
      "class_type": "ControlNetApplyAdvanced",
      "inputs": {
        "positive": [
          "apply_controlnet_canny",
          0
        ],
        "negative": [
          "apply_controlnet_canny",
          1
        ],
        "control_net": [
          "controlnet_depth",
          0
        ],
        "image": [
          "load_depth",
          0
        ],
        "strength": 0.9,
        "start_percent": 0.0,
        "end_percent": 0.8
      }
    },
    "empty_latent": {
