    "vae_decode": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "sampler",
          0
        ],
        "vae": [
          "checkpoint",
          2
        ]
      }
    },
    "save_image": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "vae_decode",
          0
