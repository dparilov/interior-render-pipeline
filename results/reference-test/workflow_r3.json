    "vae_encode": {
      "class_type": "VAEEncode",
      "inputs": {
        "pixels": [
          "load_init",
          0
        ],
        "vae": [
          "checkpoint",
          2
        ]
      }
    },
    "sampler": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "checkpoint",
          0
        ],
        "positive": [
          "positive",
          0
        ],
        "negative": [
          "negative",
          0
        ],
        "latent_image": [
          "vae_encode",
          0
        ],
        "seed": 42,
        "steps": 25,
        "cfg": 7.0,
        "sampler_name": "euler",
        "scheduler": "normal",
        "denoise": 0.3
      }
    },
    "vae_decode": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "sampler",
          0
        ],
        "vae": [
          "checkpoint",
          2
        ]
      }
    },
    "save_image": {
      "class_type": "SaveImage",
      "inputs": {
        "images": [
          "vae_decode",
          0
        ],
        "filename_prefix": "R3_img2img"
      }
    }
  }
}