{
  "prompt": {
    "checkpoint": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "RealVisXL_V4.0.safetensors"
      }
    },
    "positive": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blue and white geometric floor tiles, high quality render, seamless texture",
        "clip": [
          "checkpoint",
          1
        ]
      }
    },
    "negative": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "blurry, distorted, wrong pattern, low quality",
        "clip": [
          "checkpoint",
          1
        ]
      }
    },
    "load_init": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "reference-test/R3_init_tiled.png"
      }
