{
  "_comment": "S0 - RunPod Infrastructure Smoke Test",
  "_description": "Minimal workflow: Canny ControlNet only, no Depth, no Boundary, no IPAdapter",
  
  "prompt": {
    "checkpoint": {
      "class_type": "CheckpointLoaderSimple",
      "inputs": {
        "ckpt_name": "sd_xl_base_1.0.safetensors"
      }
    },
    
    "controlnet_canny": {
      "class_type": "ControlNetLoader",
      "inputs": {
        "control_net_name": "control-lora-canny-rank256.safetensors"
      }
    },
    
    "load_beauty": {
      "class_type": "LoadImage",
      "inputs": {
        "image": "beauty.png"
      }
    },
    
    "canny_preprocess": {
      "class_type": "CannyEdgePreprocessor",
      "inputs": {
        "image": ["load_beauty", 0],
        "low_threshold": 100,
        "high_threshold": 200,
        "resolution": 1024
      }
    },
    
    "empty_latent": {
      "class_type": "EmptyLatentImage",
      "inputs": {
        "width": 1920,
        "height": 1080,
        "batch_size": 1
      }
    },
    
    "positive": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "modern bathroom interior, white walls, floor tiles, bathtub, vanity with mirror, natural lighting, photorealistic, high quality",
        "clip": ["checkpoint", 1]
      }
    },
    
    "negative": {
      "class_type": "CLIPTextEncode",
      "inputs": {
        "text": "cartoon, anime, drawing, sketch, low quality, blurry, distorted, watermark, text",
        "clip": ["checkpoint", 1]
      }
    },
    
    "apply_controlnet_canny": {
      "class_type": "ControlNetApplyAdvanced",
      "inputs": {
        "positive": ["positive", 0],
        "negative": ["negative", 0],
        "control_net": ["controlnet_canny", 0],
        "image": ["canny_preprocess", 0],
        "strength": 0.8,
        "start_percent": 0.0,
        "end_percent": 0.9,
        "vae": ["checkpoint", 2]
      }
    },
    
    "sampler": {
      "class_type": "KSampler",
      "inputs": {
        "model": ["checkpoint", 0],
        "positive": ["apply_controlnet_canny", 0],
        "negative": ["apply_controlnet_canny", 1],
        "latent_image": ["empty_latent", 0],
        "seed": 42,
        "steps": 30,
        "cfg": 7.0,
        "sampler_name": "dpmpp_2m_sde",
        "scheduler": "karras",
        "denoise": 1.0
      }
    },
    
    "decode": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": ["sampler", 0],
        "vae": ["checkpoint", 2]
      }
    },
    
    "save": {
      "class_type": "SaveImage",
      "inputs": {
        "images": ["decode", 0],
        "filename_prefix": "S0_runpod_smoke"
      }
    }
  }
}
