      "inputs": {
        "width": 1920,
        "height": 1080,
        "batch_size": 1
      }
    },
    "set_latent_mask": {
      "class_type": "SetLatentNoiseMask",
      "inputs": {
        "samples": [
          "empty_latent",
          0
        ],
        "mask": [
          "load_boundary",
          0
        ]
      }
    },
    "sampler": {
      "class_type": "KSampler",
      "inputs": {
        "model": [
          "ipadapter_mirror",
          0
        ],
        "positive": [
          "apply_controlnet_depth",
          0
        ],
        "negative": [
          "apply_controlnet_depth",
          1
        ],
        "latent_image": [
          "set_latent_mask",
          0
        ],
        "seed": 42,
        "steps": 50,
        "cfg": 7.0,
        "sampler_name": "dpmpp_2m_sde",
        "scheduler": "karras",
        "denoise": 1.0
      }
    },
    "vae_decode": {
      "class_type": "VAEDecode",
      "inputs": {
        "samples": [
          "sampler",
          0
        ],
        "vae": [
          "checkpoint",
          2
        ]
